{
  "name": "bashmak",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check:arch": "node scripts/check-architecture.mjs",
    "build": "node scripts/check-architecture.mjs && tsc && vite build",
